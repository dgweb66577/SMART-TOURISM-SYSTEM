{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Dev Server (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      }
    },
    {
      "label": "AI Service: FastAPI (Python)",
      "type": "shell",
      "command": "python -m uvicorn main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/ai-service"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Supabase: Start Local Stack",
      "type": "shell",
      "command": "supabase start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Docker: Run Full Dev Stack",
      "type": "shell",
      "command": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
